#!/bin/bash
# UAV-Link self-update helper. Run as root by the web UI via uav-update@<channel>.service.
#   channel: development | beta | releases | <commit-sha>
#     development -> main branch (dev)               [API-free]
#     <commit-sha> -> genau dieser Commit (7-40 hex)  [API-free] -- zum gezielten
#                    Zurueckgehen auf aeltere Builds beim Testen
#     releases    -> latest stable GitHub Release     [API-free: latest-release redirect]
#     beta        -> newest Release incl. pre-release [uses the GitHub API, 60/h/IP;
#                    may rate-limit behind shared CGNAT — the other two channels do not]
# Downloads that source package and runs its install.sh (idempotent: config +
# credentials are preserved). Logs to /var/log/uav-update.log.
set -uo pipefail
REPO="b14ckyy/UAV-Link"
CHANNEL="${1:-releases}"
LABEL="$CHANNEL"
LOG=/var/log/uav-update.log
exec >>"$LOG" 2>&1
echo "=========================================================="
echo "[uav-update] $(date -u '+%Y-%m-%dT%H:%M:%SZ') channel=$CHANNEL"

# Nur EIN Update-Lauf zur Zeit. uav-update@dev und uav-update@<sha> sind
# VERSCHIEDENE systemd-Instanzen -- systemd serialisiert sie nicht. Zwei
# parallele install.sh haben am 15.08. config.txt/cmdline.txt auf 0 Bytes
# zerlegt (beide schreiben mit >>/sed an denselben Boot-Dateien).
exec 9>>/run/lock/uav-update.lock
if ! flock -w 900 9; then
    echo "[uav-update] anderer Update-Lauf haengt seit >15 min -- Abbruch"
    exit 1
fi

api() { curl -fsSL -H 'Accept: application/vnd.github+json' "https://api.github.com/repos/$REPO/$1"; }
tag_of() { grep -m1 '"tag_name"' | sed -E 's/.*"tag_name": *"([^"]+)".*/\1/'; }

case "$CHANNEL" in
    development)
        URL="https://github.com/$REPO/archive/refs/heads/main.tar.gz"; NAME="main" ;;
    beta)
        TAG="$(api 'releases?per_page=1' | tag_of)"
        [ -n "$TAG" ] || { echo "[uav-update] no release published (beta channel empty)"; exit 1; }
        URL="https://github.com/$REPO/archive/refs/tags/$TAG.tar.gz"; NAME="$TAG" ;;
    [0-9a-f]*)
        # Direkter Commit-Hash (7-40 Hex) -> genau dieser Stand. Erlaubt gezieltes
        # Zurueckgehen auf aeltere Builds zum Testen. API-frei, GitHub liefert fuer
        # jeden Commit ein Tarball unter /archive/<sha>.tar.gz
        case "$CHANNEL" in
            *[!0-9a-f]*) echo "[uav-update] ungueltiger Kanal/Commit: $CHANNEL"; exit 1 ;;
        esac
        if [ ${#CHANNEL} -lt 7 ] || [ ${#CHANNEL} -gt 40 ]; then
            echo "[uav-update] Commit-Hash muss 7-40 Zeichen haben: $CHANNEL"; exit 1
        fi
        URL="https://github.com/$REPO/archive/$CHANNEL.tar.gz"; NAME="$CHANNEL"
        LABEL="development@pinned" ;;
    releases|*)
        # API-free (robust behind CGNAT/LTE): follow the "latest release" redirect
        LOC="$(curl -sI "https://github.com/$REPO/releases/latest" | grep -i '^location:' | tr -d '\r')"
        TAG="$(echo "$LOC" | grep -oE 'tag/[^/[:space:]]+$' | sed 's#tag/##')"
        [ -n "$TAG" ] || { echo "[uav-update] no stable release published (releases channel empty)"; exit 1; }
        URL="https://github.com/$REPO/archive/refs/tags/$TAG.tar.gz"; NAME="$TAG" ;;
esac

echo "[uav-update] fetching $NAME"
D="$(mktemp -d)"
trap 'rm -rf "$D"' EXIT           # always clean up the download, even on failure/kill
TB="$D/pkg.tar.gz"
if ! curl -fsSL "$URL" -o "$TB"; then
    echo "[uav-update] download failed"; exit 1
fi
# API-free commit id: GitHub tarballs are git-archive output, whose pax global
# header carries the full commit SHA -- no API call, works behind CGNAT/LTE.
COMMIT="$(zcat "$TB" 2>/dev/null | head -c 2048 | tr -d '\0' | grep -aoE 'comment=[0-9a-f]{40}' | head -1 | sed 's/comment=//')"
COMMIT="${COMMIT:0:7}"
if ! tar -xzf "$TB" -C "$D"; then
    echo "[uav-update] extract failed"; exit 1
fi
rm -f "$TB"
SH="$(echo "$D"/*/install/install.sh)"
[ -f "$SH" ] || { echo "[uav-update] install.sh missing in package"; exit 1; }
# commit date: git archive stamps every file's mtime with the commit time (API-free)
CDATE="$(date -u -d "@$(stat -c %Y "$SH" 2>/dev/null || echo 0)" '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || true)"
echo "[uav-update] running installer (channel=$CHANNEL commit=${COMMIT:-?} committed=${CDATE:-?})"
UAV_CHANNEL="$LABEL" UAV_COMMIT="${COMMIT:-unknown}" UAV_COMMIT_DATE="${CDATE:-}" bash "$SH"
RC=$?
echo "[uav-update] done (exit $RC)"
exit $RC
