#!/bin/bash
# UAV-Link: HDMI->CSI-Bridge (Toshiba TC358743) betriebsbereit machen.
#
#   uav-hdmi-setup [device]        # ohne Argument: Bridge selbst suchen
#
# Zwei Schritte, ohne die der Chip kein Bild liefert:
#
#  1. EDID. Der TC358743 hat ab Werk KEINS. Die HDMI-Quelle fragt es beim
#     Anstecken ab, bekommt nichts und sendet daraufhin gar nicht erst -- der
#     klassische Fall "alles richtig verkabelt, Bild trotzdem schwarz". Das EDID
#     legt ausserdem fest, welche Modi die Quelle ueberhaupt anbietet.
#  2. DV-Timings. Der Treiber kennt die Aufloesung des anliegenden Signals erst,
#     wenn sie einmal abgefragt und uebernommen wurde. Vorher meldet das Device
#     0x0 und jedes Capture scheitert sofort.
#
# EDID-Quelle, in dieser Reihenfolge:
#   /boot/firmware/tc358743.edid   (Nutzer-Override, ueberlebt Updates)
#   <skriptverzeichnis>/tc358743.edid
#   sonst: v4l2-ctl --set-edid=type=hdmi (CTA-861, eingebaut, immer gueltig)
#
# Der eingebaute Typ bewirbt bis 1080p60, der TC358743 kann aber nur 165 MHz
# Pixeltakt (= 1080p30 ODER 720p60). Quellen, die stur den hoechsten beworbenen
# Modus waehlen, muessen deshalb ueber eine eigene EDID-Datei begrenzt werden.
# Wer die Quelle selbst auf 720p60 stellt, braucht das nicht.
#
# Ohne angeschlossenes HAT ein No-Op -- das Skript laeuft beim Boot JEDER
# Installation, auch auf Geraeten, die nie eine CSI-Bridge sehen werden.
#
# Exit: 0 = Timings gelockt | 2 = Bridge da, aber kein Signal | 3 = keine Bridge
set -u

DIR="$(cd "$(dirname "$0")" && pwd)"
log() { echo "[uav-hdmi] $*"; }

# --- Bridge finden ------------------------------------------------------------
find_bridge() {
    local dev name
    for dev in /dev/video*; do
        [ -e "$dev" ] || continue
        name="$(cat "/sys/class/video4linux/$(basename "$dev")/name" 2>/dev/null)"
        case "$name" in
            *tc358743*|*unicam*)
                # Nur Capture-Nodes, keine Metadaten-Nodes (unicam legt beides an)
                v4l2-ctl -d "$dev" --all 2>/dev/null | grep -q 'Video Capture' \
                    && { echo "$dev"; return 0; }
                ;;
        esac
    done
    return 1
}

DEV="${1:-}"
if [ -z "$DEV" ]; then
    DEV="$(find_bridge)" || {
        log "keine HDMI/CSI-Bridge gefunden -- uebersprungen (kein Fehler)"
        exit 3
    }
fi
[ -e "$DEV" ] || { log "Device $DEV existiert nicht"; exit 3; }
log "Bridge: $DEV ($(cat "/sys/class/video4linux/$(basename "$DEV")/name" 2>/dev/null))"

# ACHTUNG, zwei verschiedene Fragen an den Treiber:
#   --query-dv-timings  = "was liegt JETZT am HDMI-Eingang an?"  (scheitert ohne Signal)
#   --get-dv-timings    = "worauf ist das Device EINGESTELLT?"   (zeigt ohne Signal
#                          die 640x480-Defaults -- sieht aus wie ein Lock, ist keiner)
# Die Unterscheidung ist der Kern dieses Skripts: Die alte Version fragte hier
# get statt query, hielt die Defaults fuer ein gelocktes Signal und uebersprang
# das EDID-Schreiben -- die Quelle sah nie ein Display und sendete nie.
signal_detected() {
    v4l2-ctl -d "$DEV" --query-dv-timings 2>/dev/null | grep -qE 'Active width: *[1-9]'
}

active_dims() {
    # "1920x1080" aus query bzw. get -- fuer den Abgleich erkannt vs. eingestellt
    v4l2-ctl -d "$DEV" "$1" 2>/dev/null \
        | grep -oE 'Active (width|height): *[0-9]+' | grep -oE '[0-9]+' | paste -sd x -
}

force_uyvy() {
    # Die Bridge bietet BGR3, UYVY und RGB3 an und nimmt BGR3 als Default.
    # BGR3 sind 24 bit statt 16 -- 50 % mehr CSI-Bandbreite fuer exakt dieselbe
    # Bildinformation, und der Encoder muesste zusaetzlich Farbraum wandeln.
    # UYVY nehmen v4l2h264enc und v4l2jpegenc direkt entgegen.
    v4l2-ctl -d "$DEV" --set-fmt-video=pixelformat=UYVY >/dev/null 2>&1
}

report() {
    log "Signal: $(v4l2-ctl -d "$DEV" --get-fmt-video 2>/dev/null \
        | grep -oE "Width/Height *: *[0-9]+/[0-9]+|Pixel Format *: *'[A-Z0-9]+'" \
        | tr '\n' ' ')$(v4l2-ctl -d "$DEV" --get-dv-timings 2>/dev/null \
        | grep -oE '\([0-9.]+ frames per second\)')"
}

# --- Signal liegt schon an? Dann das EDID NICHT anfassen ----------------------
# Jeder EDID-Schreibvorgang wirkt auf die Quelle wie ein Hotplug: ein Laptop
# schaltet den Ausgang komplett ab und handelt neu aus. Der RTSP-Server ruft
# dieses Skript periodisch auf, solange er keine Quelle hat -- ohne diese
# Abkuerzung wuerde ein laufendes Signal im Minutentakt abgewuergt.
# Massgeblich ist das ERKANNTE Signal (query), nicht die eingestellten Timings.
# Passen die eingestellten Timings nicht zum Signal (z. B. 640x480-Default nach
# dem Boot, Quelle liefert 1080p), werden sie uebernommen -- das ist kein
# Hotplug, die Quelle merkt davon nichts.
if signal_detected; then
    if [ "$(active_dims --query-dv-timings)" != "$(active_dims --get-dv-timings)" ]; then
        v4l2-ctl -d "$DEV" --set-dv-bt-timings query >/dev/null 2>&1 \
            && log "Timings vom Signal uebernommen"
    fi
    force_uyvy
    report
    exit 0
fi

# --- 1. EDID schreiben --------------------------------------------------------
EDID=""
for cand in /boot/firmware/tc358743.edid "$DIR/tc358743.edid"; do
    [ -f "$cand" ] && { EDID="$cand"; break; }
done
EDID_SET=0
if [ -n "$EDID" ]; then
    if v4l2-ctl -d "$DEV" --set-edid="file=$EDID" --fix-edid-checksums >/dev/null 2>&1; then
        log "EDID aus Datei: $EDID"
        EDID_SET=1
    else
        log "WARN: EDID-Datei $EDID abgelehnt -- nehme das eingebaute"
    fi
fi
if [ "$EDID_SET" = 0 ]; then
    if v4l2-ctl -d "$DEV" --set-edid=type=hdmi >/dev/null 2>&1; then
        log "EDID: eingebautes CTA-861 (type=hdmi)"
    else
        log "WARN: EDID konnte nicht geschrieben werden -- Quelle sendet evtl. nichts"
    fi
fi

# --- 2. Auf das Signal warten und die Timings uebernehmen ---------------------
# Die Quelle sieht den EDID-Wechsel als Hotplug, schaltet den Ausgang ab und
# handelt neu aus. Ein fester "sleep 2" reicht dafuer nicht -- ein Laptop
# braucht deutlich laenger, und beim Booten ist der Pi ohnehin frueher fertig
# als die Gegenseite. Deshalb pollen statt raten.
for _ in $(seq 1 15); do
    sleep 1
    v4l2-ctl -d "$DEV" --set-dv-bt-timings query >/dev/null 2>&1 && break
done

if ! signal_detected; then
    log "kein HDMI-Signal erkannt -- Quelle aus, Kabel lose, oder Modus wird nicht unterstuetzt"
    log "  (TC358743 kann max. 165 MHz Pixeltakt: 720p60 oder 1080p30, KEIN 1080p60)"
    exit 2
fi

force_uyvy
report
exit 0
